# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
# Python 3.12 env used only to regenerate TFLite artifacts (TensorFlow has no 3.14 wheel)
.venv-export/
env/

# Export intermediates: onnx2tf writes these on the way to .tflite. The .tflite artifacts ARE
# tracked; these by-products are large, non-deterministic, and never deployed.
models/pretrained/*_saved_model/
models/pretrained/yolov8n.onnx*

# IDE / local tooling
.vscode/
.idea/
.claude/

# onnx2tf downloads this sample-calibration file into the CWD during TFLite export
calibration_image_sample_data_*.npy

# setuptools build output (created by a non-editable `pip install .`)
build/
dist/

# Training telemetry + regenerable script outputs (final results archived in docs/results/)
runs/
.ruff_cache/
.mypy_cache/
cv_results*.json

# Stock Ultralytics weights: fetched by `python scripts/fetch_weights.py`, not committed
# (yolov8x.pt is 131 MB, over GitHub's 100 MB limit). The project's OWN weights under
# models/best/ and the edge TFLite exports ARE tracked.
models/pretrained/yolov8x.pt
models/pretrained/yolov8s-cls.pt
models/pretrained/yolov8n.pt

# Derived crop datasets: regenerated from the tracked raw datasets/indianbovine1 by the
# crop/prep step. bovine_cls is also training scratch (oversample + augmentation copies).
datasets/bovine_crops/
datasets/bovine_cls/
